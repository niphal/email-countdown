# Local database (created on server at runtime)
/data/*.db
/data/*.sqlite

# Cached TTF from Google Fonts repos (downloaded at install / first image request)
/data/fonts/*.ttf
/data/fonts/*.tmp.*

# Auth (copy from secrets.example.php)
/data/secrets.php

# Runtime mail / debug logs (SMTP "log" transport, reset & verify fallbacks)
/data/*.log
/data/*.jsonl

# Uploaded brand template backgrounds (per workspace)
/data/template_assets/**/*
!/data/template_assets/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local scratch files
/_test_*.php
/_out.png
/_curl_out.bin
